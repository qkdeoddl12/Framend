{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framend",
  "version": "0.1.0",
  "identifier": "app.framend.recovery",
  "build": {
    "beforeDevCommand": "npm run stage-engine && npm run dev",
    "beforeBuildCommand": "npm run stage-engine && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Framend", "width": 1180, "height": 820, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/recovery-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "nsis": { "languages": ["English", "Korean"], "displayLanguageSelector": true } }
  }
}
